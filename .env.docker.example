# Copy to .env.docker and set unique secrets before running Docker Compose.
MYSQL_PASSWORD=replace-with-a-private-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
JWT_SECRET=replace-with-at-least-32-random-private-characters
ENABLE_AI_MODELS=false
# Set BUILD_AI=true to install PyTorch and vision dependencies in the image.
BUILD_AI=false
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

