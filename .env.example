# Local development. Copy to .env; never commit credentials.
ENVIRONMENT=development
# SQLite, uploads and local Qdrant default to this directory.
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
INFERENCE_CONCURRENCY=1
AUTO_CREATE_TABLES=true
# Development creates a local signing key. Production requires a private secret.
JWT_SECRET=

# Install requirements-ai.txt to enable Falconsai and OpenCLIP.
ENABLE_AI_MODELS=true
# Empty URL selects embedded Qdrant: no server or API key needed.
QDRANT_URL=
QDRANT_API_KEY=
# Optional overrides; otherwise storage is derived from DATA_DIR.
# DATABASE_URL=sqlite:///./data/sentinel.db
# QDRANT_LOCAL_PATH=data/qdrant
HF_HOME=data/models
# Optional external explanations; local explanations work without this.
GEMINI_API_KEY=
# Windows example, only if Tesseract is not already on PATH:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
