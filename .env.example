# Local development. Copy to .env; never commit credentials.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/sentinel.db
DATA_DIR=data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50
INFERENCE_CONCURRENCY=1
AUTO_CREATE_TABLES=true
# Development creates a persistent local signing key if this is omitted.
# Production requires a private random value of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-private-characters

# Heavy vision models are opt-in and download weights on first use.
ENABLE_AI_MODELS=true
# Optional vector service; do not expose Qdrant to the public internet.
QDRANT_URL=https://qdrant.tech/
QDRANT_LOCAL_PATH=data/qdrant
QDRANT_API_KEY=your_qdrant_api_key_here
# Set only when you want frames and OCR signals sent to Google for explanation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash


# Download model weights here, then reuse them across backend restarts.
HF_HOME=data/models
# Windows example: C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
