# Copy to .env and adjust.

# MySQL database
# URL-encode special characters in the password (e.g. @ → %40)
DATABASE_URL=mysql+pymysql://root:Vishnu%40123@localhost:3306/nsfw_copyright_db

NSFW_MODEL_ID=Falconsai/nsfw_image_detection
CLIP_MODEL_ID=openai/clip-vit-base-patch32

NSFW_THRESHOLD=0.5
DUPLICATE_THRESHOLD=0.92
MAX_GIF_FRAMES=16

CORS_ORIGINS=*
LAZY_LOAD_MODELS=true

# ChromaDB vector store (copyright / duplicate detection)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=media_embeddings
